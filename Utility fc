    <title>UTILITY FC | Official Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #111111;
            color: #ffffff;
            line-height: 1.6;
        }

        header {
            background: #000000;
            padding: 25px 15px;
            text-align: center;
            border-bottom: 3px solid #d4af37;
        }

        header h1 {
            color: #d4af37;
            font-size: 38px;
            letter-spacing: 4px;
        }

        header p {
            color: #dddddd;
            margin-top: 5px;
        }

        nav {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 22px;
            padding: 18px 10px;
            background: #191919;
            border-bottom: 1px solid #333333;
        }

        nav a {
            color: #ffffff;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            color: #d4af37;
        }

        .hero {
            text-align: center;
            padding: 100px 20px;
            background: linear-gradient(135deg, #111111, #29230e);
        }

        .hero h2 {
            color: #d4af37;
            font-size: 42px;
            margin-bottom: 15px;
        }

        .hero p {
            color: #dddddd;
            margin-bottom: 30px;
            font-size: 17px;
        }

        .button {
            display: inline-block;
            background: #d4af37;
            color: #000000;
            padding: 13px 28px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: bold;
        }

        .button:hover {
            background: #ffffff;
        }

        .section {
            text-align: center;
            padding: 65px 20px;
            border-bottom: 1px solid #333333;
        }

        .section h2 {
            color: #d4af37;
            font-size: 30px;
            margin-bottom: 15px;
        }

        .section p {
            color: #cccccc;
        }

        footer {
            text-align: center;
            padding: 25px 15px;
            background: #000000;
            color: #bbbbbb;
        }

        footer span {
            color: #d4af37;
        }

        @media (max-width: 600px) {
            header h1 {
                font-size: 30px;
            }

            .hero h2 {
                font-size: 30px;
            }

            nav {
                gap: 14px;
            }
        }
    </style>
</head>


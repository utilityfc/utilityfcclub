<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Utility FC - E-Football Club</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0b1325;
            color: #ffffff;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #040814;
            color: #d4af37;
            padding: 30px 20px;
            text-align: center;
        }
        nav {
            background-color: #1a2536;
            text-align: center;
            padding: 15px 0;
        }
        nav a {
            color: #ffffff;
            margin: 0 20px;
            text-decoration: none;
            font-weight: bold;
            transition: color 0.3s;
        }
        nav a:hover {
            color: #d4af37;
        }
        .container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 20px;
            background-color: #1a2536;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        }
        h2 {
            color: #d4af37;
            border-bottom: 2px solid #d4af37;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .match-details, .registration-form {
            margin-top: 30px;
        }
        input, select, textarea {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border: 1px solid #3b4c66;
            border-radius: 4px;
            background-color: #0b1325;
            color: #ffffff;
            box-sizing: border-box;
        }
        button {
            background-color: #d4af37;
            color: #040814;
            padding: 12px 25px;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        button:hover {
            background-color: #ffd700;
        }
        footer {
            background-color: #040814;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }
    </style>
</head>
<body>

<header>
    <h1>Utility FC</h1>
    <p>Official E-Football Club</p>
</header>

<nav>
    <a href="#about">Home</a>
    <a href="#matches">Matches</a>
    <a href="#register">Player Registration</a>
</nav>

<div class="container" id="about">
    <h2>About Our Club</h2>
    <p>Utility FC is a professional e-football club dedicated to achieving world-class performance and building a strong competitive gaming community.</p>

    <div class="match-details" id="matches">
        <h2>Upcoming Match Details</h2>
        <p><strong>Opponent:</strong> Dynamo Gaming</p>
        <p><strong>Date:</strong> October 25, 2026</p>
        <p><strong>Time:</strong> 8:00 PM</p>
    </div>

    <div class="registration-form" id="register">
        <h2>Player Registration Form</h2>
        <form action="#" method="POST">
            <label for="name">Full Name:</label>
            <input type="text" id="name" name="name" required>

            <label for="email">Email Address:</label>
            <input type="email" id="email" name="email" required>

            <label for="position">Preferred Position:</label>
            <select id="position" name="position" required>
                <option value="forward">Forward</option>
                <option value="midfielder">Midfielder</option>
                <option value="defender">Defender</option>
                <option value="goalkeeper">Goalkeeper</option>
            </select>

            <label for="experience">Gaming Experience:</label>
            <textarea id="experience" name="experience" rows="4" placeholder="Briefly describe your past gaming or e-football experience"></textarea>

            <button type="submit">Submit Registration</button>
        </form>
    </div>
</div>

<footer>
    <p>&copy; 2026 Utility FC. All rights reserved.</p>
</footer>

</body>
</html>
